#!/usr/bin/python3
# SPDX-License-Identifier: Apache-2.0
"""PreToolUse hook for shell commands, for Claude Code and Codex alike.

Reads the hook payload on stdin (both agents send tool_input.command and
cwd) and answers only when lib/agent_policy/checks.py finds something:

  deny  the agent is told not to retry or work around it, and to ask the
        user to run the command themselves (`! <command>` in either agent).
  ask   Claude Code shows its normal prompt. Codex cannot be told to prompt
        from a hook, and its allow rules run outside the sandbox without
        asking, so for Codex an ask becomes a deny that says approval is
        needed.

  allow Claude Code only, and only with --allow: a command the static
        rules would allow but for `git -C <dir>`, an aws read verb, or an
        AWS profile or region set in front of an infrastructure tool, which
        they cannot express without a wildcard Claude Code warns about
        (approve() in checks.py). Every deny and ask rule still applies.

Silence means no opinion: the static rules (policy/*.toml) decide, and
what they do not name falls to the agent (Claude Code's auto mode
classifier, or its prompt).

--mode permissive is refused, and the guard runs hardened, unless the
environment declares it holds the boundary (held_mode()).

With the ask log on (lib/agent_policy/asklog.py), every ask and deny it can
see is also appended to a local file, after the answer is written; a log
that cannot be written changes nothing.
"""

import json
import os
import signal
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
# lib/ sits next to the script once installed, and one level up in a checkout.
LIB = HERE / "lib" if (HERE / "lib" / "agent_policy").is_dir() else HERE.parent / "lib"
sys.path.insert(0, str(LIB))

from agent_policy import asklog
from agent_policy.checks import MODES, approve, evaluate

# A hook that crashes reports a non-blocking error, and the command runs
# unchecked; so every failure to check is answered with a refusal instead.
UNCHECKED = (
    "agent-policy could not check this command, so it refused it rather than "
    "letting it through unchecked."
)

HAND_OFF = (
    "Do not retry it, rephrase it or work around it. If it is really "
    "needed, ask the user to run it themselves; they can type "
    "`! {command}` in Claude Code or Codex."
)


# permissive (docs/POLICY.md, "Modes") leaves what the guard cannot judge to
# Claude Code's classifier, which is safe only where an environment around
# the agent holds the boundary: a devcontainer-airlock workbench. It declares
# that twice, and the guard takes permissive only when both hold: the session
# level it gives the agent (AIRLOCK_LEVEL, which a command the agent runs
# cannot change for the agent itself or its hooks), and the file podman
# writes into every container it runs, which no host has.
BOUNDARY_LEVEL = "AIRLOCK_LEVEL"
CONTAINER_MARKER = "/run/.containerenv"
REFUSED = (
    "agent-policy: permissive mode was refused, so this session runs hardened. "
    "It is only for an environment that holds the boundary (docs/POLICY.md, "
    '"Modes"); here {why}.'
)


def held_mode(mode, agent, env):
    """(the mode the guard runs, a notice for the user or ""). Every mode but
    permissive is taken as given. permissive is Claude Code's alone (Codex has
    no classifier to leave a line to) and needs the environment's word for it;
    anything less fails closed to hardened, and says why."""
    if mode != "permissive":
        return mode, ""
    if agent != "claude":
        return "hardened", REFUSED.format(why="the agent is not Claude Code")
    if env.get(BOUNDARY_LEVEL) != "permissive":
        return "hardened", REFUSED.format(why=f"{BOUNDARY_LEVEL} is not permissive")
    if not os.path.isfile(CONTAINER_MARKER):
        return "hardened", REFUSED.format(why="the guard is not running in a container")
    return mode, ""


def respond(decision, reason, notice=""):
    answer = {
        "hookSpecificOutput": {
            "hookEventName": "PreToolUse",
            "permissionDecision": decision,
            "permissionDecisionReason": reason,
        }
    }
    if notice:
        answer["systemMessage"] = notice
    json.dump(answer, sys.stdout)
    sys.stdout.flush()


def tell(notice):
    """`notice` with no decision, for a line the guard leaves to the rules:
    Claude Code shows a systemMessage to the user on its own."""
    if notice:
        json.dump({"systemMessage": notice}, sys.stdout)
        sys.stdout.flush()


def option(argv, name, default=None):
    if name in argv and argv.index(name) + 1 < len(argv):
        return argv[argv.index(name) + 1]
    return default


def load_rules(path):
    """What tools/render.py wrote to guard-allow.json, or nothing."""
    if path is None:
        return {}
    try:
        data = json.loads(Path(path).read_text())
    except (OSError, ValueError):
        return {}
    return data if isinstance(data, dict) else {}


def load_allowed(data):
    """The allowed prefixes, or none. A file that is missing or unreadable
    approves nothing, which leaves every decision to the static rules: a
    prompt, never a command let through."""
    prefixes = data.get("prefixes")
    if not isinstance(prefixes, list):
        return []
    return [p for p in prefixes if isinstance(p, list) and p and all(isinstance(w, str) for w in p)]


# How long the ask log may take, well inside the hook's 10 second timeout.
LOG_SECONDS = 2


def _stalled(_signum, _frame):
    raise TimeoutError("the ask log took too long")


def log_ask(record):
    """Append `record()` to the ask log (lib/agent_policy/asklog.py) when the
    log is on and `record()` is not None. Called only once the answer is
    written. Never raises and never takes longer than LOG_SECONDS: the log
    must not change a decision or keep the hook past its timeout."""
    previous = signal.signal(signal.SIGALRM, _stalled)
    signal.setitimer(signal.ITIMER_REAL, LOG_SECONDS)
    try:
        log = asklog.path()
        line = record() if log else None
        if line:
            asklog.append(log, line)
    except Exception:
        # The log is best effort: whatever went wrong, the answer stands.
        return
    finally:
        signal.setitimer(signal.ITIMER_REAL, 0)
        signal.signal(signal.SIGALRM, previous)


def unchecked(agent, mode, command="", cwd=""):
    return lambda: asklog.entry(agent, mode, "guard", "deny", "unchecked", command, cwd)


def found(agent, mode, command, cwd, finding):
    reason = finding.key or finding.check
    return lambda: asklog.entry(
        agent, mode, "guard", finding.decision, reason, command, cwd, finding.severity
    )


def left_to_rules(agent, mode, command, cwd, data):
    """The record for a line the guard was silent on, if the rendered rules
    ask, deny or match nothing on it."""

    def record():
        home = os.environ.get("HOME") or os.path.expanduser("~")
        verdict = asklog.classify(command, cwd, home, load_allowed(data), asklog.static_rules(data))
        if verdict is None:
            return None
        decision, rule, unmatched = verdict
        return asklog.entry(agent, mode, "rules", decision, rule, command, cwd, None, unmatched)

    return record


def main(argv):
    agent = option(argv, "--agent", "claude")
    # The mode the policy was rendered for (docs/POLICY.md, "Modes"). An
    # unknown one is hardened, the policy as written.
    mode = option(argv, "--mode", "hardened")
    mode = mode if mode in MODES else "hardened"
    mode, notice = held_mode(mode, agent, os.environ)
    # Claude Code shows the notice (respond(), tell()); Codex reads only the
    # decision, so its notice goes to standard error.
    shown = notice if agent == "claude" else ""
    if notice and not shown:
        print(notice, file=sys.stderr)
    # Codex is never approved: its allow runs a command outside its sandbox.
    data = load_rules(option(argv, "--allow")) if agent == "claude" else {}
    allowed = load_allowed(data)
    try:
        payload = json.load(sys.stdin)
    except ValueError:
        respond("deny", UNCHECKED, shown)
        log_ask(unchecked(agent, mode))
        return 0
    tool_input = payload.get("tool_input") if isinstance(payload, dict) else None
    command = tool_input.get("command") if isinstance(tool_input, dict) else None
    if isinstance(command, list):
        command = " ".join(str(word) for word in command)
    if not isinstance(command, str) or not command.strip():
        if not isinstance(payload, dict):
            respond("deny", UNCHECKED, shown)
            log_ask(unchecked(agent, mode))
        return 0
    cwd = payload.get("cwd")
    cwd = cwd if isinstance(cwd, str) and cwd else os.getcwd()
    # Plan mode is read only, so nothing is approved there, and nothing it
    # leaves to the rules is logged as a prompt.
    if payload.get("permission_mode") == "plan":
        allowed = []
    try:
        finding = evaluate(command, cwd, mode=mode)
        approved = finding is None and approve(command, cwd, allowed)
    except Exception:
        respond("deny", UNCHECKED, shown)
        log_ask(unchecked(agent, mode, command, cwd))
        return 0
    if approved:
        respond(
            "allow",
            "agent-policy: allowed once the guard read past git -C, an aws service"
            " or an AWS profile in front",
        )
        return 0
    if finding is None:
        tell(shown)
        # Only Claude Code's hook is given the rules (--allow), and without
        # them there is nothing to tell an allowed line from one that asks.
        if allowed:
            log_ask(left_to_rules(agent, mode, command, cwd, data))
        return 0
    one_line = " ".join(command.split())
    tag = f"agent-policy, {finding.severity}"
    if finding.decision == "deny":
        respond(
            "deny",
            f"Blocked ({tag}): {finding.reason}. " + HAND_OFF.format(command=one_line),
            shown,
        )
    elif agent == "codex":
        respond(
            "deny",
            f"Needs the user's approval ({tag}): {finding.reason}. "
            "Explain why it is needed and ask the user to approve it, or "
            f"to run it themselves with `! {one_line}`.",
        )
    else:
        respond("ask", f"{tag}: {finding.reason}", shown)
    log_ask(found(agent, mode, command, cwd, finding))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
