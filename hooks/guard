#!/usr/bin/python3
# SPDX-License-Identifier: Apache-2.0
"""PreToolUse hook for shell commands, for Claude Code and Codex alike.

Reads the hook payload on stdin (both agents send tool_input.command and
cwd) and answers only when lib/agent_policy/checks.py finds something:

  deny  the agent is told not to retry or work around it, and to ask the
        user to run the command themselves (`! <command>` in either agent).
  ask   Claude Code shows its normal prompt. Codex cannot be told to prompt
        from a hook, and its allow rules run outside the sandbox without
        asking, so for Codex an ask becomes a deny that says approval is
        needed.

Silence means no opinion: the static rules (policy/*.toml) decide.
"""

import json
import os
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
for candidate in (HERE / "lib", HERE.parent / "lib"):
    if (candidate / "agent_policy").is_dir():
        sys.path.insert(0, str(candidate))
        break

from agent_policy.checks import evaluate

HAND_OFF = (
    "Do not retry it, rephrase it or work around it. If it is really "
    "needed, ask the user to run it themselves; they can type "
    "`! {command}` in Claude Code or Codex."
)


def respond(decision, reason):
    json.dump(
        {
            "hookSpecificOutput": {
                "hookEventName": "PreToolUse",
                "permissionDecision": decision,
                "permissionDecisionReason": reason,
            }
        },
        sys.stdout,
    )


def main(argv):
    agent = "claude"
    if "--agent" in argv and argv.index("--agent") + 1 < len(argv):
        agent = argv[argv.index("--agent") + 1]
    try:
        payload = json.load(sys.stdin)
    except ValueError:
        respond(
            "deny",
            "agent-policy could not read the hook payload, so it refused "
            "the command rather than letting it through unchecked.",
        )
        return 0
    command = (payload.get("tool_input") or {}).get("command")
    if isinstance(command, list):
        command = " ".join(command)
    if not isinstance(command, str) or not command.strip():
        return 0
    finding = evaluate(command, payload.get("cwd") or os.getcwd())
    if finding is None:
        return 0
    one_line = " ".join(command.split())
    tag = f"agent-policy, {finding.severity}"
    if finding.decision == "deny":
        respond(
            "deny",
            f"Blocked ({tag}): {finding.reason}. " + HAND_OFF.format(command=one_line),
        )
    elif agent == "codex":
        respond(
            "deny",
            f"Needs the user's approval ({tag}): {finding.reason}. "
            "Explain why it is needed and ask the user to approve it, or "
            f"to run it themselves with `! {one_line}`.",
        )
    else:
        respond("ask", f"{tag}: {finding.reason}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
